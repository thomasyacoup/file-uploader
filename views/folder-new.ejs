<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>create folder</title>
</head>
<body>
  <% if (errors.length > 0) { %>
    <ul>
      <% for (const error of errors) { %>
        <li><%= error.msg %></li>
      <% } %>
    </ul>
  <% } %>
  <form action="/folder/new" method="post">
    <input type="text" id="name" name="name" placeholder="Folder Name" value="<%= oldInput.name %>" required>
    <button type="submit">Create</button>
  </form>
</body>
</html>
