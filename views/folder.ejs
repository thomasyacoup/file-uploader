<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>folder <%= folder.name %></title>
</head>
<body>
  <h1>
    <%= folder.name %>
  </h1>
  <p><%= folder.createdAt %></p>
  <button type="button">
    <a href="/file/new?folderId=<%= folder.id %>">upload file</a>
  </button>
  <ul>
    <% for (let file of folder.files) { %>
    <li>
      <%= file.name %>
      <a href="/file/<%= file.id %>">View</a>
    </li>
    <% } %>
  </ul>
</body>
</html>
