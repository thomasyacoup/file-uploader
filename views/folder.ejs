<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>folder <%= folder.name %></title>
</head>
<body>
  <h1>
    <%= folder.name %>
  </h1>
  <p><%= folder.createdAt %></p>
  <button type="button">
    <a href="/file/new?folderId=<%= folder.id %>">upload file</a>
  </button>
  <form action="/folder/<%= folder.id %>/share" method="post">
    <input type="submit" value="Share">
  </form>
  <ul>
    <% for (let file of folder.files) { %>
    <li>
      <%= file.name %>
      <a href="/file/<%= file.id %>">View</a>
    </li>
    <% } %>
  </ul>

  <ul>
    Share Links
    <% for (let link of folder.shareLinks) {%>
      <li>
        <a href="<%= req.headers.host+ '/share/' + link.id %>"><%= req.headers.host+ '/share/' + link.id %></a> (<%= link.expiresAt < Date.now() ? 'expired' : 'active for ' + Math.ceil((link.expiresAt - Date.now()) / 1000 / 60 / 60)  + 'H' %>)
      </li>
    <%}%>
  </ul>
</body>
</html>
