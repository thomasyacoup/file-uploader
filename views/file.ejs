<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= file.name %></title>
</head>
<body>
  <h3><%= file.name %></h3>
  <a href="/"><button>Back</button></a>
  <ul>
    <li>upload date: <%= file.createdAt %></li>
    <li>size: <%= Number(file.size) / 1024 %>KB</li>
    <li>folder: <%= file.folder ? file.folder.name : "root" %></li>
  </ul>
  <form action="/file/<%= file.id %>/delete" method="get"><button>Delete</button></form>
  <form action="/file/<%= file.id %>/download" method="get"><button>Download</button></form>
</body>
</html>
