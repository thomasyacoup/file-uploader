<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>upload file</title>
	<style>
		body {
			font-family: Arial, sans-serif;
			background-color: #f5f5f5;
			margin: 0;
			padding: 20px;
		}
		.container {
			max-width: 500px;
			margin: 0 auto;
			background: #fff;
			border-radius: 8px;
			box-shadow: 0 2px 8px rgba(0,0,0,0.1);
			padding: 20px;
		}
		h1 {
			margin-top: 0;
			font-size: 22px;
			color: #333;
		}
		form {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		input[type="file"] {
			padding: 8px;
			border: 1px solid #ccc;
			border-radius: 4px;
		}
		button {
			background: #007bff;
			color: white;
			border: none;
			padding: 10px 16px;
			border-radius: 4px;
			cursor: pointer;
			font-size: 14px;
		}
		button:hover {
			background: #0056b3;
		}
		ul.errors {
			list-style: none;
			padding: 0;
			margin: 0 0 10px 0;
			color: #d9534f;
		}
	</style>
</head>
<body>
	<div class="container">
		<h1>Upload File</h1>
		<% if (errors) { %>
			<ul class="errors">
				<% errors.forEach((error) => { %>
					<li><%= error.msg %></li>
				<% }); %>
			</ul>
		<% } %>
		<form action="/file/new" method="post" enctype="multipart/form-data">
			<input type="hidden" name="folderId" value="<%= folder %>">
			<input type="file" name="file" placeholder="file" value="<%= oldInput?.file %>">
			<button type="submit">Upload</button>
		</form>
	</div>
</body>
</html>
