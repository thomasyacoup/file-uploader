<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>folder <%= folder.name %></title>
</head>
<body>
  <h1>
    <%= folder.name %>
  </h1>
  <p><%= folder.createdAt %></p>
  <ul>
    <% for (let file of folder.files) { %>
    <li>
      <%= file.name %>
      <button type="button">
        <a href="/file/<%= file.id %>/download?shareId=<%= shareLink.id %>">download</a>
      </button>
    </li>
    <% } %>
  </ul>
</body>
</html>
